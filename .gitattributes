* text=auto eol=lf
*.npz binary
*.png binary
*.gz binary
*.bin binary
# Preserve the fixture metadata bytes already bound to executed solver records.
fixtures/solver-matrices.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve the exact cost-receipt bytes referenced by derived PCA summaries.
results/pca-cost-audit.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Rejected originals and forensic receipts have exact retained-byte bindings.
fixtures/pca-input-failure/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
results/pca-input-failure-audit.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
